{
  "rewrites": [
    { "source": "/api/ml/:path*", "destination": "/api/ml/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.go": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/ml/index.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
